NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-09

# Server-only. Not needed until draft/private content access (e.g. draft mode) is set up.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity publish webhook (app/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Brevo: website forms and newsletter (lib/brevo.ts)
BREVO_API_KEY=
# Newsletter list id (Brevo → Contacts → Lists). Without it, opt-ins are skipped.
BREVO_LIST_ID=
# Optional: double opt-in template id; sign-ups then confirm by email first.
BREVO_DOI_TEMPLATE_ID=
